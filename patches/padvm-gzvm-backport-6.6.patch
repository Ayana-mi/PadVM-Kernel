+/*
+ * PadVM: the OPD2407 device tree ships /hypervisor with status "disabled",
+ * so the platform bus never creates a device and the probe hypercall is never
+ * issued. With gzvm.force_probe (default on), register a DT-less platform
+ * device so the normal probe runs. The firmware accepts the probe on this
+ * device; gzvm.force_probe=0 restores stock behaviour.
+ */
+static bool force_probe = true;
+module_param(force_probe, bool, 0444);
+MODULE_PARM_DESC(force_probe, "Probe GenieZone even if the DT node is disabled");
+
+static struct platform_device *gzvm_forced_pdev;
